<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Progress and preferences are the only user data; keep them on this device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
